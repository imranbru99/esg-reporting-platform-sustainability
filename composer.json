{
    "name": "imrandevbd/esg-reporting-platform-auto-generated-sustainability-reports",
    "description": "A comprehensive enterprise ESG operating system for automating sustainability reports.",
    "type": "project",
    "require": {
        "filament/filament": "^5.11",
        "imrandevbd/drutogoti": "dev-main",
        "imrandevbd/laravel-admin-panel": "dev-main",
        "imrandevbd/laravel-ai-catalog": "dev-main",
        "imrandevbd/laravel-ai-hub": "^1.7",
        "imrandevbd/laravel-attendance-hub": "dev-main",
        "imrandevbd/laravel-unicode-pdf": "dev-main",
        "imrandevbd/laravel-universal-slug": "dev-main",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "@tailwindcss/vite": "^2.2",
        "concurrently": "^6.2",
        "laravel-vite-plugin": "^1.0",
        "tailwindcss": "^3.0",
        "vite": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Filament\\": "app/Filament/"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "serve": "php artisan serve"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "imrandevbd/drutogoti",
                "imrandevbd/laravel-admin-panel",
                "imrandevbd/laravel-ai-catalog",
                "imrandevbd/laravel-ai-hub",
                "imrandevbd/laravel-attendance-hub",
                "imrandevbd/laravel-unicode-pdf",
                "imrandevbd/laravel-universal-slug"
            ]
        }
    }
}
